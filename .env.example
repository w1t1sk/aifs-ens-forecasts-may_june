# MinIO / S3-compatible object store credentials
# Copy this file to .env, fill in your values, and source it before running
# any of the zarr-conversion or helper scripts:
#
#   cp .env.example .env
#   # edit .env with your credentials
#   source .env
#
# Never commit .env to version control.

MINIO_ENDPOINT=http://your-minio-server:9000
MINIO_ACCESS_KEY=your_access_key_here
MINIO_SECRET_KEY=your_secret_key_here
